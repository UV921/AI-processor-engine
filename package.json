{
  "name": "ai-resarch-processor",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n server,worker,eval -c blue,green,magenta \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:eval\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:eval": "tsx watch src/evalutaion-engine/eavlution-worekr.ts",
    "dev:frontend": "npm run dev --prefix Frontend/vite-project",
    "dev:all": "concurrently -n server,worker,eval,web -c blue,green,magenta,yellow \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:eval\" \"npm:dev:frontend\"",
    "start": "concurrently -n server,worker,eval -c blue,green,magenta \"npm:start:server\" \"npm:start:worker\" \"npm:start:eval\"",
    "start:server": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "start:eval": "tsx src/evalutaion-engine/eavlution-worekr.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.12.0",
    "bullmq": "^5.80.8",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
